{
  "expo": {
    "name": "My Apps",
    "slug": "my-apps",
    "scheme": "myapps",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#02050d",
    "splash": {
      "backgroundColor": "#02050d"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.myapps.home",
      "adaptiveIcon": {
        "backgroundColor": "#0b1838",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "reactCompiler": true
    },
    "plugins": ["expo-sqlite", "expo-sharing", "expo-image"],
    "extra": {
      "supportsRTL": false,
      "eas": {
        "projectId": "c3bb2955-0df6-4772-a520-fbecd2190fcf"
      }
    },
    "owner": "eliyabsnss517",
    "updates": {
      "url": "https://u.expo.dev/c3bb2955-0df6-4772-a520-fbecd2190fcf"
    }
  }
}
